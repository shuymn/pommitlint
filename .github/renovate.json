{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>shuymn/github-actions#main"
  ],
  "mise": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchPackageNames": ["/^@commitlint//", "/^conventional-changelog-/"],
      "groupName": "commitlint"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/release.yml"
      ],
      "matchStrings": [
        "GO_LICENSES_VERSION: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "google/go-licenses"
    }
  ]
}
